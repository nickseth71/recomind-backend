# ============================================================
#  RecoMind Backend — Environment Variables
#
#  RENAME THIS FILE: env.example → .env  (add the dot)
#  Then fill in every value below.
# ============================================================

NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# Your Render backend URL (no trailing slash)
APP_URL=https://your-backend.onrender.com

# ─── MongoDB ─────────────────────────────────────────────────
# MongoDB Atlas → Connect → Drivers → Node.js
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/recomind?retryWrites=true&w=majority

# ─── Redis ───────────────────────────────────────────────────
# Upstash or Redis Cloud connection URL
REDIS_URL=redis://default:password@redis-host:6379

# ─── OpenAI ──────────────────────────────────────────────────
OPENAI_API_KEY=sk-proj-...
OPENAI_MODEL=gpt-4o
OPENAI_MAX_TOKENS=2000

# ─── JWT ─────────────────────────────────────────────────────
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_long_random_string
JWT_EXPIRES_IN=7d

# ─── Encryption ──────────────────────────────────────────────
# Used to AES-encrypt Shopify access tokens in MongoDB
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=replace_with_64_char_hex_string

# ─── Shopify ─────────────────────────────────────────────────
# Only needed to verify incoming webhook payloads
# Partner Dashboard → Your App → Notifications → Webhooks
SHOPIFY_WEBHOOK_SECRET=your_shopify_webhook_secret

# ─── Admin Panel ─────────────────────────────────────────────
# Sent as X-Admin-Key header to access /api/admin/* routes
ADMIN_SECRET_KEY=replace_with_strong_admin_secret

# ─── CORS ────────────────────────────────────────────────────
# Your Shopify app frontend URL + admin panel URL
ALLOWED_ORIGINS=https://your-shopify-app.vercel.app,https://admin.RecoMind.io

# ─── Rate Limiting ───────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ─── Job Queue ───────────────────────────────────────────────
QUEUE_CONCURRENCY=3
QUEUE_JOB_DELAY_MS=500
# In development the API auto-starts the worker. Set false to use a separate process (npm run worker).
AUTO_START_WORKER=true

# ─── Logging ─────────────────────────────────────────────────
LOG_LEVEL=info